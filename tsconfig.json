{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,

    // ⭐ 핵심: 타입 폴더 인식
    "baseUrl": ".",

    // ⭐ alias 유지
    "paths": {
      "@/*": ["./*"]
    },

    // ⭐ 타입 오류 방지
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
