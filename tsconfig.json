{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "lib": ["es2017", "dom", "dom.iterable", "esnext"],
    "jsx": "react-native",
    "baseUrl": ".",

    // ⭐ alias 유지
    "paths": {
      "@/*": ["./*"]
    },

    // ⭐ 타입 오류 방지
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
